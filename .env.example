# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép tệp này thành .env và điền các thông tin bí mật của bạn.
# LƯU Ý: KHÔNG BAO GIỜ COMMIT TỆP .env LÊN GITHUB HOẶC KHO CHỨA PUBLIC!
# ============================================================

# Cổng khởi chạy Web Server Backend (Mặc định: 3000)
PORT=3000

# ------------------------------------------------------------
# PINATA IPFS CLOUD CONFIGURATION (Lưu trữ hồ sơ ứng viên)
# Đăng ký tài khoản miễn phí tại: https://app.pinata.cloud
# Tạo API Key với quyền pinFileToIPFS rồi copy JWT vào đây.
# ------------------------------------------------------------
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=https://purple-fashionable-rooster-653.mypinata.cloud/ipfs/

# ------------------------------------------------------------
# SEPOLIA TESTNET DEPLOYMENT (Khi triển khai ra mạng thực tế)
# RPC URL từ Alchemy, Infura, QuickNode,...
# Private Key của ví deploy (KHÔNG CÓ TIỀN THẬT, CHỈ DÙNG TESTNET)
# ------------------------------------------------------------
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id
SEPOLIA_PRIVATE_KEY=your_sepolia_wallet_private_key_without_0x_prefix
